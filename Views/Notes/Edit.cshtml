@model Notes_API.Models.Request.EditRequestModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="ru">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Редактировать заметку</title>

    <link rel="stylesheet"
          href="~/css/styles.css">

</head>

<body>

<div class="bg-elements"></div>

<div class="auth-container">

    <div class="auth-header">

        <h1 class="auth-title">
            Редактирование
        </h1>

        <p class="auth-subtitle">
            Измените содержимое заметки
        </p>

    </div>


    <form
        asp-controller="Notes"
        asp-action="Edit"
        asp-route-id="@ViewBag.NoteId"
        method="post">

        @Html.AntiForgeryToken()


        <div class="form-group">

            <label
                class="form-label"
                asp-for="Title">

                Название

            </label>

            <input
                asp-for="Title"
                class="form-input"
                placeholder="Название заметки..."
                required>

        </div>


        <div class="form-group">

            <label
                class="form-label"
                asp-for="Content">

                Текст

            </label>

            <textarea
                asp-for="Content"
                class="form-input note-edit-textarea"
                placeholder="Текст заметки..."
                required></textarea>

        </div>


        <button
            type="submit"
            class="btn">

            Сохранить

        </button>

    </form>


    <div class="auth-link">

        <a
            asp-controller="Notes"
            asp-action="List">

            ← Вернуться к заметкам

        </a>

    </div>

</div>

</body>

</html>