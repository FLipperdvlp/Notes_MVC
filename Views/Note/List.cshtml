@using Notes_API.Models
@model IEnumerable<Notes_API.Models.NoteViewModel>

@{
	ViewData["Title"] = "Мои заметки";
}

<main class="notes-page">
	<div class="notes-header">
		<div>
			<h1>Мои заметки</h1>
			<p>Все ваши заметки в одном месте</p>
		</div>
		<a class="button button-primary" href="/Note/Create">+ Новая заметка</a>
	</div>

	@if (Model == null || !Model.Any())
	{
		<section class="empty-state">
			<h2>Заметок пока нет</h2>
			<p>Создайте первую заметку, чтобы начать.</p>
			<a class="button button-primary" href="/Note/Create">Создать заметку</a>
		</section>
	}
	else
	{
		<section class="notes-grid">
			@foreach (var note in Model)
			{
				<article class="note-card">
					<div class="note-card-content">
						<h2>@note.Title</h2>
						<p>@note.Content</p>
					</div>
					<div class="note-card-footer">
						<a href="/Note/Edit/@note.Id">Изменить</a>
						<form method="post" action="/Note/Delete/@note.Id"
							  onsubmit="return confirm('Удалить эту заметку?');">
							@Html.AntiForgeryToken()
							<button type="submit" class="link-button">Удалить</button>
						</form>
					</div>
				</article>
			}
		</section>
	}
</main>
